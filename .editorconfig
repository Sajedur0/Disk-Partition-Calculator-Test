root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 8

[*.{xml,json,yml,yaml}]
indent_size = 4

# Vector drawables and the manifest keep single long lines (path data / attribute lists).
[*.xml]
max_line_length = off

# Long single-line settings and generated/README lines are allowed to exceed 100 columns.
[*.{properties,toml,md}]
max_line_length = off

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
