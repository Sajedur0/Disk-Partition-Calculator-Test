<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. The real UI (colours, glass, typography) is drawn by
         Jetpack Compose — this theme only paints the window before the first frame. -->
    <style name="Theme.DiskCalc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backdrop_base_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
