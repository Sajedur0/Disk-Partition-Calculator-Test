<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Mode window theme -->
    <style name="Theme.DiskCalc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backdrop_base_dark</item>
        <item name="android:statusBarColor">@color/backdrop_base_dark</item>
        <item name="android:navigationBarColor">@color/backdrop_base_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
